---
// Sleep Moore is on the App Store: a button on phones, a QR code on computers
// (public/img/app-qr.svg, made by scripts/app-qr.py). Android is not out yet,
// so the launch list takes an email for the Google Play launch.
// Posts to the `signup` edge function (supabase/functions/signup); wired in scripts/app.ts.
import { APP_STORE_URL } from '../data/site';
const apple = 'M16.4 12.6c0-2.4 2-3.6 2.1-3.7-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.9-1.7 0-3.3 1-4.2 2.5-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.6 0 2 .8 3.4.8 1.4 0 2.3-1.2 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9-.1 0-2.9-1.1-2.9-4.2zM13.9 5.3c.7-.9 1.2-2 1-3.3-1 0-2.2.7-2.9 1.6-.6.7-1.2 1.9-1.1 3.1 1.1.1 2.3-.6 3-1.4z';
---
<section class="get" id="get" aria-labelledby="get-title">
  <div class="wrap">
    <div class="get-inner reveal">
      <p class="cap"><span>On the App Store now</span><span class="cap-sep" aria-hidden="true"> · </span><span>Android coming soon</span></p>
      <h2 id="get-title">Goodnight, <em>properly</em>.</h2>
      <p class="get-lede">Free on iPhone. No account, nothing to sign up for. Just open it and listen.</p>
      <div class="beta">
        <a class="beta-go" href={APP_STORE_URL} data-track="App Store download">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={apple}/></svg>
          <span><small>Download on the</small><b>App Store</b></span>
        </a>
        <figure class="beta-qr">
          <img src="/img/app-qr.svg" width="168" height="168" loading="lazy" decoding="async" alt="QR code that opens Sleep Moore on the App Store">
          <figcaption><b>Scan with your iPhone camera</b><span>It opens Sleep Moore on the App Store. Free, no account.</span><a href={APP_STORE_URL} data-track="App Store link (desktop)">Or open the App Store page</a></figcaption>
        </figure>
      </div>
      <p class="get-or">On Android? One email the day it lands on Google Play, nothing else.</p>
      <form class="launch" data-launch novalidate>
        <div class="stores" role="radiogroup" aria-label="Your phone">
          <button type="button" class="store" role="radio" aria-checked="true" data-platform="android">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.6 2.3c-.3.3-.4.7-.4 1.2v17c0 .5.1.9.4 1.2l9.5-9.7L3.6 2.3zm10.5 8.7 2.7-2.8L5.6 1.8c-.4-.2-.8-.3-1.1-.2l9.6 9.4zm0 2-9.6 9.4c.3.1.7 0 1.1-.2l11.2-6.4-2.7-2.8zm7.2-1.8-3.4-2-3 3 3 3 3.4-2c.9-.5.9-1.5 0-2z"/></svg>
            <span><small>Coming soon</small><b>Google Play</b></span>
          </button>
        </div>
        <div class="launch-row">
          <label class="sr-only" for="launch-email">Your email</label>
          <input id="launch-email" type="email" name="email" autocomplete="email" inputmode="email" placeholder="you@example.com" required>
          <div class="launch-trap" aria-hidden="true"><label>Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
          <button type="submit" class="launch-go">Email me at launch</button>
        </div>
        <p class="launch-msg" role="status" aria-live="polite"></p>
      </form>
      <p class="get-note">We use your email once, to say the app is out, then delete it. <a href="/privacy/#website">Privacy</a></p>
    </div>
  </div>
</section>
