---
import { EMAIL } from '../data/site';
---
<section class="get" id="get" aria-labelledby="get-title">
  <div class="wrap">
    <div class="get-inner reveal">
      <p class="cap">Coming soon to iPhone and Android</p>
      <h2 id="get-title">Goodnight, <em>properly</em>.</h2>
      <div class="stores">
        <span class="store">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.4 12.6c0-2.4 2-3.6 2.1-3.7-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.9-1.7 0-3.3 1-4.2 2.5-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.6 0 2 .8 3.4.8 1.4 0 2.3-1.2 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9-.1 0-2.9-1.1-2.9-4.2zM13.9 5.3c.7-.9 1.2-2 1-3.3-1 0-2.2.7-2.9 1.6-.6.7-1.2 1.9-1.1 3.1 1.1.1 2.3-.6 3-1.4z"/></svg>
          <span><small>Coming soon</small><b>App Store</b></span>
        </span>
        <span class="store">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.6 2.3c-.3.3-.4.7-.4 1.2v17c0 .5.1.9.4 1.2l9.5-9.7L3.6 2.3zm10.5 8.7 2.7-2.8L5.6 1.8c-.4-.2-.8-.3-1.1-.2l9.6 9.4zm0 2-9.6 9.4c.3.1.7 0 1.1-.2l11.2-6.4-2.7-2.8zm7.2-1.8-3.4-2-3 3 3 3 3.4-2c.9-.5.9-1.5 0-2z"/></svg>
          <span><small>Coming soon</small><b>Google Play</b></span>
        </span>
      </div>
      <p class="get-note">Want to know the day it lands? Write to <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.</p>
    </div>
  </div>
</section>
