---
// Night journeys: an endless carousel of story covers. Each card plays the real opening of the
// story, read by the app's narrator over the sounds of the place. Five copies of the cards are
// rendered so the row never runs out (app.ts recentres on the middle copy); only the middle copy
// is in the tab order and the accessibility tree.
import { Picture } from 'astro:assets';
import { STORY_COLORS, STORY_COVERS } from '../data/scenes';
import { STORIES } from '../data/worlds';
import Icon from './Icon.astro';
import PlayIcons from './PlayIcons.astro';

const COPIES = 5;
const middle = Math.floor(COPIES / 2);
const cards = Array.from({ length: COPIES }, (_, copy) => STORIES.map((story) => ({ story, copy }))).flat();
---
<section class="stories" id="stories" aria-labelledby="stories-title">
  <div class="wrap stories-head">
    <header class="sec-head reveal">
      <p class="cap stories-eyebrow">Night journeys</p>
      <h2 id="stories-title">Stories to fall asleep to.</h2>
      <p class="sub">Read slowly by one calm voice, with the sounds of the place underneath. Press play to hear how each one begins.</p>
    </header>
  </div>

  <div class="carousel" data-carousel data-dock-hide role="region" aria-roledescription="carousel" aria-label="Night journeys">
    <button class="carousel-arrow prev" type="button" aria-label="Previous story" data-prev><Icon name="arrow-left" /></button>
    <ul class="carousel-track" role="list" tabindex="0" aria-label="Stories, use the arrow keys to move" data-track data-copies={COPIES}>
      {cards.map(({ story, copy }) => {
        const real = copy === middle;
        return (
          <li class="story-card" data-card aria-hidden={real ? undefined : 'true'}>
            <figure class="story-cover">
              <Picture
                src={STORY_COVERS[story.id]}
                formats={['avif', 'webp']}
                widths={[420, 640, 840]}
                sizes="(max-width: 760px) 78vw, 380px"
                alt=""
                loading="lazy"
                decoding="async"
                style={`background-color:${STORY_COLORS[story.id]}`}
              />
              {story.isNew && <span class="story-badge">New</span>}
              <span class="story-progress" aria-hidden="true"><i data-progress-for={story.id}></i></span>
            </figure>
            <div class="story-body">
              <p class="story-meta"><Icon name={story.icon} /> Night journey · {story.minutes} min</p>
              <h3 class="story-name">{story.name}</h3>
              <p class="story-line">{story.tagline}</p>
              <button
                class="story-play"
                type="button"
                data-play-world={story.id}
                aria-pressed="false"
                tabindex={real ? undefined : -1}>
                <span class="story-play-ring"><PlayIcons /></span>
                <span data-label data-idle="Hear the opening">Hear the opening</span>
                <span class="sr-only">, {story.name}</span>
              </button>
            </div>
          </li>
        );
      })}
    </ul>
    <button class="carousel-arrow next" type="button" aria-label="Next story" data-next><Icon name="arrow-right" /></button>
  </div>

  <div class="wrap">
    <p class="stories-note">In the app each journey runs {STORIES.map((s) => s.minutes).sort((a, b) => a - b)[0]} to {Math.max(...STORIES.map((s) => s.minutes))} minutes: the story, then the sounds carry on and fade as you sleep. Add rain to any of them.</p>
  </div>
</section>
