---
// The page for one story or meditation: the cover and a play button for the opening, what it is and
// who it suits, the words themselves (a story's opening, a meditation in full), then more like it.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Faq from './Faq.astro';
import GetApp from './GetApp.astro';
import Icon from './Icon.astro';
import LibHero from './LibHero.astro';
import Mixer from './Mixer.astro';
import type { GuidedPage } from '../data/guides';

type Item = { id: string; name: string; tagline: string; minutes: number; icon: string };
interface Props {
  kind: 'story' | 'meditation';
  item: Item;
  page: GuidedPage;
  cover: ImageMetadata;
  coverAlt: string;
  color: string;
  /** Short label for the cap, e.g. "Night journey · 45 min". */
  cap: string;
  /** The story's opening paragraphs, or the meditation's every line. */
  words: string[];
  totalWords: number;
  others: (Item & { cover: ImageMetadata; color: string; meta: string })[];
}
const { kind, item, page, cover, coverAlt, color, cap, words, totalWords, others } = Astro.props;
const story = kind === 'story';
const hub = story ? { href: '/stories/', label: 'All sleep stories' } : { href: '/meditations/', label: 'All meditations' };
---
<div data-world-page={item.id}>
  <LibHero
    back={hub}
    cap={cap}
    title={item.name}
    line={item.tagline}
    mix={item.id}
    play={story ? 'Hear the opening' : 'Try the first minutes'}
    chips={[{ icon: 'clock', label: `${item.minutes} min` }, { icon: 'narrator', label: 'One calm voice' }, { icon: 'sparkle', label: 'Free' }]}
    art={cover}
    artAlt={coverAlt}
    color={color}
    shape="tall"
  />

  <section class="lib-body" aria-label={`About ${item.name}`}>
    <div class="wrap lib-grid">
      <article class="lib-article">
        <h2>{story ? 'What happens' : 'What it is'}</h2>
        {page.about.map((p) => <p set:html={p} />)}
        <p class="lib-for"><Icon name="moon" /> <span>{page.forWho}</span></p>

        <h2>{story ? 'How it begins' : 'Every word'}</h2>
        <div class="lib-words">
          {words.map((w) => <p>{w}</p>)}
        </div>
        <p class="lib-words-note">
          {story
            ? `The opening, about ${words.join(' ').split(/\s+/).length} of the story’s ${Math.round(totalWords / 100) * 100} words. The rest is in the app, read slowly with long pauses, and the sound carries on after the voice and fades.`
            : 'Read slowly, with long pauses between the lines. In the app a soft pad plays on after the voice ends, then fades, and the screen dims for the night.'}
        </p>
      </article>
      <aside class="lib-aside" aria-label="Player">
        <Mixer world={item.id} class="world-mixer" timer={false} />
        <p class="lib-aside-note">{story ? 'The first minutes, as the app plays them: the voice over the sound of the place. Lower the voice or the bed to taste.' : 'The first minutes, as the app plays them: the voice over a soft pad.'}</p>
      </aside>
    </div>
  </section>

  <section class="lib-related" aria-labelledby="others-title">
    <div class="wrap">
      <header class="sec-head">
        <h2 id="others-title">{story ? 'More stories.' : 'More meditations.'}</h2>
      </header>
      <ul class="cover-grid" role="list">
        {others.map((o) => (
          <li>
            <a class="cover-card" href={`/${story ? 'stories' : 'meditations'}/${o.id}/`} data-play-world={o.id}>
              <Picture src={o.cover} formats={['avif', 'webp']} widths={[320, 480]} sizes="(max-width: 760px) 44vw, 260px" alt="" loading="lazy" decoding="async" style={`background-color:${o.color}`} />
              <span class="cover-card-text">
                <span class="cap">{o.meta}</span>
                <span class="cover-card-name">{o.name}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Faq faq={page.faq} />
  <GetApp />
</div>
