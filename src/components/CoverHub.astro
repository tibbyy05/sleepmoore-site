---
// A hub of covers (all stories, all meditations): heading, a line, then one card per item.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import GetApp from './GetApp.astro';

interface Props {
  eyebrow: string;
  title: string;
  lede: string;
  base: 'stories' | 'meditations';
  items: { id: string; name: string; tagline: string; meta: string; cover: ImageMetadata; color: string }[];
}
const { eyebrow, title, lede, base, items } = Astro.props;
---
<section class="page-head lib-head">
  <div class="wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p>{lede}</p>
  </div>
</section>
<section class="lib-group lib-group-last">
  <div class="wrap">
    <ul class="cover-grid cover-grid-wide" role="list">
      {items.map((o) => (
        <li>
          <a class="cover-card" href={`/${base}/${o.id}/`} data-play-world={o.id}>
            <Picture src={o.cover} formats={['avif', 'webp']} widths={[320, 480, 640]} sizes="(max-width: 760px) 44vw, 300px" alt="" loading="lazy" decoding="async" style={`background-color:${o.color}`} />
            <span class="cover-card-text">
              <span class="cap">{o.meta}</span>
              <span class="cover-card-name">{o.name}</span>
              <span class="cover-card-line">{o.tagline}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
<GetApp />
