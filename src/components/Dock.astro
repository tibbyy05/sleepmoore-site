---
// The player dock: rises from the bottom once sound has started and stays through every page
// change (transition:persist), so the night keeps playing while you look around.
import { getImage } from 'astro:assets';
import { SOUND_PAGES } from '../data/library';
import { MEDITATION_COVERS, SCENES, STORY_COVERS, TILES } from '../data/scenes';
import { MEDITATIONS, STORIES, WORLDS } from '../data/worlds';
import Icon from './Icon.astro';
import PlayIcons from './PlayIcons.astro';

const thumbs: Record<string, string> = {};
for (const w of WORLDS) {
  const img = await getImage({ src: SCENES[w.id], width: 112, height: 112, fit: 'cover', format: 'webp' });
  thumbs[w.id] = img.src;
}
thumbs['my-scene'] = '/img/scene-thumb.svg'; // Build your scene on the home page
for (const s of STORIES) {
  const img = await getImage({ src: STORY_COVERS[s.id], width: 112, height: 112, fit: 'cover', position: 'top', format: 'webp' });
  thumbs[s.id] = img.src;
}
for (const m of MEDITATIONS) {
  const img = await getImage({ src: MEDITATION_COVERS[m.id], width: 112, height: 112, fit: 'cover', format: 'webp' });
  thumbs[m.id] = img.src;
}
for (const p of SOUND_PAGES) {
  const img = await getImage({ src: TILES[p.tile], width: 112, height: 112, fit: 'cover', format: 'webp' });
  thumbs[`sound-${p.slug}`] = img.src;
}
---
<aside id="dock" class="dock" aria-label="Now playing" aria-hidden="true" inert data-thumbs={JSON.stringify(thumbs)} transition:persist transition:name="dock">
  <a class="dock-world" href="/worlds/rainy-cabin/" data-dock-link>
    <img data-dock-thumb src={thumbs['rainy-cabin']} alt="" width="56" height="56">
    <span class="dock-text">
      <span class="dock-name" data-now>Rainy Cabin</span>
      <span class="dock-state" data-dock-state>Paused</span>
    </span>
  </a>
  <span class="meter dock-meter" aria-hidden="true" data-meter><i></i><i></i><i></i><i></i><i></i></span>
  <button class="dock-toggle" type="button" aria-label="Play" data-toggle><PlayIcons /></button>
  <button class="dock-close" type="button" aria-label="Stop and close the player" data-dock-close><Icon name="close" /></button>
</aside>
