---
// Questions and answers as open-and-close rows. The page adds the matching FAQPage data with
// faqPage() from schema.ts, from the same list, so what Google reads matches what people see.
import type { QA } from '../data/library';

interface Props {
  faq: QA[];
  title?: string;
  id?: string;
}
const { faq, title = 'Questions, answered.', id = 'faq' } = Astro.props;
---
{faq.length > 0 && (
  <section class="faq" id={id} aria-labelledby={`${id}-title`}>
    <div class="wrap">
      <header class="sec-head">
        <h2 id={`${id}-title`}>{title}</h2>
      </header>
      <div class="faq-list">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p set:html={f.a} />
          </details>
        ))}
      </div>
    </div>
  </section>
)}
