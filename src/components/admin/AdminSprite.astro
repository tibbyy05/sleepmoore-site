---
// Phosphor icons (regular weight) for the admin page, referenced as <use href="#a-name">.
const names = [
  'chart-line', 'broadcast', 'footprints', 'file-text', 'share-network', 'globe', 'cursor-click', 'music-notes', 'gauge', 'gear',
  'sign-out', 'arrow-up-right', 'arrow-up', 'arrow-down', 'envelope', 'download-simple', 'play', 'eye', 'x', 'arrows-clockwise',
  'export', 'list', 'caret-down', 'caret-left', 'caret-right', 'funnel', 'calendar-blank', 'users', 'clock', 'check', 'warning',
  'lightning', 'device-mobile', 'desktop', 'device-tablet', 'moon-stars', 'info', 'eye-slash', 'lock-simple', 'cursor',
  // App section
  'apple-logo', 'bug', 'chat-circle-text', 'copy', 'link', 'hourglass', 'check-circle', 'x-circle', 'warning-circle', 'package', 'user-plus', 'image',
  // Summary strip
  'trend-up', 'trend-down', 'minus',
  // Shell, Home and search
  'house', 'magnifying-glass', 'arrow-right', 'gear-six', 'sidebar-simple',
  // Owner's mock: sidebar and Home icons
  'chart-bar', 'monitor', 'stack', 'target', 'app-store-logo', 'user', 'play-circle',
];
const svgs = import.meta.glob<string>('/node_modules/@phosphor-icons/core/assets/regular/*.svg', { query: '?raw', import: 'default', eager: true });
// Solid versions of the sidebar icons: the page you are on shows its icon filled.
const filled = ['house', 'chart-bar', 'monitor', 'trend-up', 'file-text', 'stack', 'users', 'target', 'lightning', 'music-notes', 'app-store-logo', 'gear-six'];
const fills = import.meta.glob<string>('/node_modules/@phosphor-icons/core/assets/fill/*.svg', { query: '?raw', import: 'default', eager: true });
const inner = (svg: string) => svg.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
const symbols = names
  .map((n) => {
    const svg = svgs[`/node_modules/@phosphor-icons/core/assets/regular/${n}.svg`];
    if (!svg) throw new Error(`Missing Phosphor icon: ${n}`);
    return `<symbol id="a-${n}" viewBox="0 0 256 256">${inner(svg)}</symbol>`;
  })
  .join('') + filled
  .map((n) => {
    const svg = fills[`/node_modules/@phosphor-icons/core/assets/fill/${n}-fill.svg`];
    if (!svg) throw new Error(`Missing Phosphor fill icon: ${n}`);
    return `<symbol id="a-${n}-fill" viewBox="0 0 256 256">${inner(svg)}</symbol>`;
  })
  .join('');
---
<svg class="sprite" aria-hidden="true" focusable="false" set:html={symbols} />
