---
// Build your scene: drag a sound into a night landscape and hear it. Plays through the site's
// engine as the "Your scene" mix (data/worlds.ts SCENE_MIX), so the player and dock follow it.
const TOKENS = [
  { id: 'fire', label: 'Campfire', icon: '<path d="M10 2c1 3 4 4.5 4 8.5A4 4 0 0 1 6 10.5C6 8 8 7.5 8 5c1.5 1 2 2.5 2 4 1-1 .5-4 0-7z" fill="#ffb35c"/>' },
  { id: 'rain', label: 'Rain cloud', icon: '<path d="M5.5 11a3.5 3.5 0 0 1 .4-7 4.5 4.5 0 0 1 8.4 1.4A2.8 2.8 0 0 1 14.5 11z" fill="#b9c6e4"/><path d="M7 13.5l-1 3M10.5 13.5l-1 3M14 13.5l-1 3" stroke="#86a9e3" stroke-width="1.5" stroke-linecap="round"/>' },
  { id: 'stream', label: 'Stream', icon: '<path d="M2 8c2.5-2 5.5 2 8 0s5.5 2 8 0M2 13c2.5-2 5.5 2 8 0s5.5 2 8 0" stroke="#86a9e3" stroke-width="1.8" fill="none" stroke-linecap="round"/>' },
  { id: 'night', label: 'Crickets', icon: '<circle cx="6" cy="8" r="2" fill="#f4f0a0"/><circle cx="13" cy="5.5" r="1.4" fill="#f4f0a0" opacity=".7"/><circle cx="14" cy="13" r="2.2" fill="#f4f0a0"/><circle cx="7" cy="15" r="1.2" fill="#f4f0a0" opacity=".6"/>' },
  { id: 'wind', label: 'Wind', icon: '<path d="M2 7h10a2.5 2.5 0 1 0-2.5-2.5M2 11h13a2.5 2.5 0 1 1-2.5 2.5M2 15h6" stroke="#d9d2c4" stroke-width="1.6" fill="none" stroke-linecap="round"/>' },
];
---
<div class="builder" data-builder>
  <div class="scene-stage" data-scene-stage>
    <svg class="scene-svg" viewBox="0 0 1000 440" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <linearGradient id="sb-sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#070b18"/><stop offset=".7" stop-color="#16203e"/><stop offset="1" stop-color="#2a2d52"/></linearGradient>
        <radialGradient id="sb-fg" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#ffb35c" stop-opacity=".75"/><stop offset=".45" stop-color="#ff8a3c" stop-opacity=".22"/><stop offset="1" stop-color="#ff8a3c" stop-opacity="0"/></radialGradient>
        <radialGradient id="sb-ffg" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#f4f0a0"/><stop offset=".35" stop-color="#e6e07a" stop-opacity=".45"/><stop offset="1" stop-color="#e6e07a" stop-opacity="0"/></radialGradient>
        <radialGradient id="sb-moon" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#f3eadb" stop-opacity=".35"/><stop offset="1" stop-color="#f3eadb" stop-opacity="0"/></radialGradient>
        <linearGradient id="sb-water" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2c4a78"/><stop offset="1" stop-color="#16294a"/></linearGradient>
      </defs>
      <rect width="1000" height="440" fill="url(#sb-sky)"/>
      <g fill="#fff" data-scene-stars></g>
      <circle cx="820" cy="84" r="70" fill="url(#sb-moon)"/>
      <circle cx="820" cy="84" r="24" fill="#efe4cc"/>
      <path d="M0 250 L120 180 L210 226 L330 150 L450 232 L560 170 L690 236 L800 186 L1000 250 L1000 440 L0 440 Z" fill="#111a33"/>
      <path d="M0 300 C 160 262 300 282 460 292 S 780 262 1000 286 L1000 440 L0 440 Z" fill="#0c1324"/>
      <path d="M0 340 C 220 322 480 336 700 330 S 920 326 1000 334 L1000 440 L0 440 Z" fill="#080d19"/>
      <g data-scene-layer></g>
    </svg>
    <p class="scene-hint" data-scene-hint>Drag a sound into the night</p>
  </div>
  <div class="tokens" role="group" aria-label="Sounds you can add">
    {TOKENS.map((t) => (
      <button type="button" class="tok" data-tok={t.id} aria-pressed="false">
        <span class="tok-ico" aria-hidden="true"><svg viewBox="0 0 20 20" set:html={t.icon} /></span>{t.label}
      </button>
    ))}
    <button type="button" class="tok tok-clear" data-scene-clear>Clear</button>
  </div>
</div>
