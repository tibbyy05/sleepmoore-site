---
// An icon from the sprite. Decorative by default (hidden from screen readers); give the
// surrounding control its accessible name.
interface Props {
  name: string;
  class?: string;
}
const { name, class: cls } = Astro.props;
---
<svg class:list={['icon', cls]} aria-hidden="true" focusable="false"><use href={`#i-${name}`} /></svg>
