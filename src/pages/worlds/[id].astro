---
// One page per world: the scene full screen and alive, its three sounds on a live mixer, and a
// way on to the next world. The picture grows out of the card you tapped, and the sound you
// started on the way in keeps playing.
import { getImage } from 'astro:assets';
import GetApp from '../../components/GetApp.astro';
import Icon from '../../components/Icon.astro';
import Mixer from '../../components/Mixer.astro';
import PlayIcons from '../../components/PlayIcons.astro';
import Scene from '../../components/Scene.astro';
import { SCENES } from '../../data/scenes';
import { SOUNDS, WORLDS, type World } from '../../data/worlds';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return WORLDS.map((world, i) => ({
    params: { id: world.id },
    props: { world, prev: WORLDS[(i - 1 + WORLDS.length) % WORLDS.length], next: WORLDS[(i + 1) % WORLDS.length] },
  }));
}
type Props = { world: World; prev: World; next: World };
const { world, prev, next } = Astro.props;

const site = 'https://sleepmoore.app';
const og = await getImage({ src: SCENES[world.id], width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const soundNames = world.layers.map(([id]) => SOUNDS[id].label.toLowerCase());
const description = `${world.name}: ${world.line} A free sleep sound world from Sleep Moore, mixed from real recordings of ${soundNames.slice(0, -1).join(', ')} and ${soundNames.at(-1)}. Play it here, then fall asleep to it in the app.`;
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Sleep Moore', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Worlds', item: `${site}/#worlds` },
    { '@type': 'ListItem', position: 3, name: world.name, item: `${site}/worlds/${world.id}/` },
  ],
};
const ADDS = world.inApp
  ? [
      { icon: 'sliders', title: 'Make it yours', text: 'Swap any of the three sounds for one of forty recordings, from brown noise to a night train, and save the mix.' },
      { icon: 'timer', title: 'Fades as you fall asleep', text: 'Pick fifteen minutes or all night. The sharper sounds drift out first, then the rest softens away.' },
      { icon: 'lock', title: 'Plays with the screen off', text: 'Lock your phone and it keeps going, with play and pause on the lock screen.' },
      { icon: 'moon', title: 'Wakes you gently', text: 'Set the time you need to be up, and the morning arrives slowly instead of all at once.' },
    ]
  : [
      { icon: 'sliders', title: 'Build it in the app', text: `${world.name} is a website mix. In the app, start from any world and swap its sounds for ${soundNames.join(', ')} to make it.` },
      { icon: 'timer', title: 'Fades as you fall asleep', text: 'Pick fifteen minutes or all night. The sharper sounds drift out first, then the rest softens away.' },
      { icon: 'lock', title: 'Plays with the screen off', text: 'Lock your phone and it keeps going, with play and pause on the lock screen.' },
      { icon: 'moon', title: 'Wakes you gently', text: 'Set the time you need to be up, and the morning arrives slowly instead of all at once.' },
    ];
---
<Base title={`${world.name}: ${world.line.replace(/\.$/, '')} | Sleep Moore`} description={description} fullBleed image={new URL(og.src, site).href}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(crumbs)} />

  <div data-world-page={world.id}>
    <section class="world-hero" aria-labelledby="world-title">
      <div class="world-art" aria-hidden="true">
        <Scene id={world.id} widths={[828, 1280, 1920, 2560]} sizes="(max-aspect-ratio: 16/9) 178vh, 100vw" loading="eager" fetchpriority="high" style={`view-transition-name:world-scene;object-position:${world.focus}`} />
        <canvas class="ambience" data-ambience={world.id}></canvas>
      </div>
      <div class="wrap world-copy">
        <a class="back-link" href="/#worlds"><Icon name="arrow-left" /> All worlds</a>
        <p class="cap">{world.cap}</p>
        <h1 id="world-title">{world.name}</h1><script is:inline>splitLetters(document.currentScript.previousElementSibling)</script>
        <p class="world-line">{world.line}</p>
        <div class="world-actions">
          <button class="play-pill" type="button" data-play-world={world.id} aria-pressed="false" data-dock-hide>
            <PlayIcons />
            <span data-label data-idle={`Play ${world.name}`}>Play {world.name}</span>
          </button>
          <ul class="world-sounds" role="list" aria-label="Sounds in this world">
            {world.layers.map(([id]) => <li><Icon name={SOUNDS[id].icon} />{SOUNDS[id].label}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="world-body" aria-labelledby="inside-title">
      <div class="wrap world-grid">
        <div class="world-about">
          <h2 id="inside-title">Three sounds, <em>one place</em>.</h2>
          <p class="world-intro">{world.intro}</p>
          <ul class="sound-list" role="list">
            {world.layers.map(([id]) => (
              <li>
                <span class="sound-icon"><Icon name={SOUNDS[id].icon} /></span>
                <span><b>{SOUNDS[id].label}</b><small>{SOUNDS[id].line}</small></span>
              </li>
            ))}
          </ul>
          <p class="world-note">These are the same recordings the app plays, mixed live in your browser. Move a fader and the scene answers.</p>
        </div>
        <Mixer world={world.id} class="world-mixer" />
      </div>
    </section>

    <section class="world-app" aria-labelledby="app-title">
      <div class="wrap app-grid">
        <figure class="app-phone">
          <img src="/img/app/explore-390.webp" srcset="/img/app/explore-390.webp 390w, /img/app/explore-780.webp 780w" sizes="(max-width: 760px) 220px, 300px" alt="The Explore screen in the Sleep Moore app: a sound world with three faders" width="390" height="844" loading="lazy" decoding="async">
          <figcaption>The real app, Explore</figcaption>
        </figure>
        <div class="app-copy">
          <h2 id="app-title">{world.inApp ? <>{world.name}, <em>all night</em>.</> : <>Make it <em>yours</em>.</>}</h2>
          <p class="app-lede">What the app adds once you are in bed.</p>
          <dl class="facts app-adds">
            {ADDS.map((a) => (
              <div><dt><Icon name={a.icon} />{a.title}</dt><dd>{a.text}</dd></div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section class="world-more" aria-labelledby="more-title">
      <div class="wrap">
        <header class="sec-head">
          <h2 id="more-title">Somewhere else tonight?</h2>
        </header>
        <div class="more-worlds">
          {[{ w: prev, dir: 'Previous' }, { w: next, dir: 'Next' }].map(({ w, dir }) => (
            <a class="more-card" href={`/worlds/${w.id}/`} data-play-world={w.id}>
              <Scene id={w.id} widths={[700, 1100]} sizes="(max-width: 760px) 100vw, 50vw" />
              <span class="more-text">
                <span class="cap">{dir} · {w.cap}</span>
                <span class="more-name">{w.name}</span>
                <span class="more-line">{w.line}</span>
              </span>
              <span class="go-ring" aria-hidden="true"><Icon name="arrow-right" /></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <GetApp />
  </div>
</Base>
