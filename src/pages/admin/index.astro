---
// Private analytics dashboard for sleepmoore.app. Data comes from the SleepMoore Supabase project
// (public.admin_* functions, admins only); the page itself is static and holds no data.
import { Font } from 'astro:assets';
import AdminSprite from '../../components/admin/AdminSprite.astro';
import '../../styles/admin.css';

const NAV = [
  { id: 'overview', label: 'Overview', icon: 'chart-line' },
  { id: 'live', label: 'Live', icon: 'broadcast' },
  { id: 'visits', label: 'Visits', icon: 'footprints' },
  { id: 'pages', label: 'Pages', icon: 'file-text' },
  { id: 'sources', label: 'Sources', icon: 'share-network' },
  { id: 'audience', label: 'Audience', icon: 'globe' },
  { id: 'clicks', label: 'Clicks & goals', icon: 'cursor-click' },
  { id: 'sounds', label: 'Sounds', icon: 'music-notes' },
  { id: 'performance', label: 'Speed', icon: 'gauge' },
  { id: 'settings', label: 'Settings', icon: 'gear' },
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="#0b0e15">
<meta name="robots" content="noindex, nofollow">
<title>Sleep Moore Admin</title>
<meta name="description" content="Private visitor analytics for sleepmoore.app.">
<link rel="icon" type="image/png" href="/favicon.png">
<Font cssVariable="--font-sans" preload={[{ weight: 400, style: 'normal' }, { weight: 700, style: 'normal' }]} />
</head>
<body class="is-booting">
<AdminSprite />

<div class="login" id="login" hidden>
  <form class="login-card" id="login-form" novalidate>
    <div class="brand"><svg class="i" aria-hidden="true"><use href="#a-moon-stars" /></svg><span>Sleep Moore</span><span class="brand-tag">Admin</span></div>
    <h2>Sign in</h2>
    <p class="login-sub">Visitor analytics for sleepmoore.app.</p>
    <label class="field"><span>Email</span><input id="login-email" type="email" autocomplete="username" required></label>
    <label class="field"><span>Password</span><input id="login-password" type="password" autocomplete="current-password" required></label>
    <p class="form-error" id="login-error" role="alert"></p>
    <button class="btn btn-primary btn-block" type="submit" id="login-submit">Sign in</button>
  </form>
</div>

<div class="shell" id="app" hidden>
  <aside class="side" aria-label="Sidebar">
    <div class="brand"><svg class="i" aria-hidden="true"><use href="#a-moon-stars" /></svg><span>Sleep Moore</span><span class="brand-tag">Admin</span></div>
    <nav class="nav" aria-label="Sections">
      {NAV.map((n) => (
        <a href={`#${n.id}`} data-nav={n.id}><svg class="i" aria-hidden="true"><use href={`#a-${n.icon}`} /></svg><span>{n.label}</span>{n.id === 'live' && <b class="nav-live" data-online hidden></b>}</a>
      ))}
    </nav>
    <div class="side-foot">
      <a class="side-link" href="/" target="_blank" rel="noopener">sleepmoore.app <svg class="i" aria-hidden="true"><use href="#a-arrow-up-right" /></svg></a>
    </div>
  </aside>

  <div class="main">
    <header class="bar">
      <div class="bar-row">
        <h1 id="title">Overview</h1>
        <span class="online" data-online-pill hidden><i></i><span data-online-text></span></span>
        <div class="bar-tools" id="tools">
          <div class="range" id="range">
            <button class="btn btn-ghost range-btn" type="button" id="range-btn" aria-haspopup="true" aria-expanded="false">
              <svg class="i" aria-hidden="true"><use href="#a-calendar-blank" /></svg><span id="range-label">Last 7 days</span><svg class="i caret" aria-hidden="true"><use href="#a-caret-down" /></svg>
            </button>
            <div class="menu" id="range-menu" hidden></div>
          </div>
          <label class="switch" title="Compare with the period before">
            <input type="checkbox" id="compare" checked><span class="switch-ui" aria-hidden="true"></span><span>Compare</span>
          </label>
          <button class="btn btn-icon" type="button" id="refresh" aria-label="Refresh"><svg class="i" aria-hidden="true"><use href="#a-arrows-clockwise" /></svg></button>
        </div>
      </div>
      <div class="chips" id="chips" hidden></div>
    </header>

    <main class="content" id="content">
      {NAV.map((n) => <section class="view" id={n.id} data-view={n.id} hidden aria-label={n.label}></section>)}
    </main>
  </div>
  <nav class="tabbar" aria-label="Sections, bottom bar">
    {NAV.map((n) => (
      <a href={`#${n.id}`} data-nav={n.id}><svg class="i" aria-hidden="true"><use href={`#a-${n.icon}`} /></svg><span>{n.label}</span></a>
    ))}
  </nav>
</div>

<div class="tip" id="tip" role="status" hidden></div>
<div class="toast" id="toast" role="status" hidden></div>

<script>
  import '../../scripts/admin/main';
</script>
</body>
</html>
