---
// Private analytics dashboard for sleepmoore.app. Data comes from the SleepMoore Supabase project
// (public.admin_* functions, admins only); the page itself is static and holds no data.
import { Font } from 'astro:assets';
import AdminSprite from '../../components/admin/AdminSprite.astro';
import '../../styles/admin.css';
import { getImage } from 'astro:assets';
import brandIcon from '../../assets/brand/sleep-moore-icon.png';
import { MEDITATIONS, SOUND_MIXES, STORIES, WORLDS } from '../../data/worlds';
import { MEDITATION_COVERS, MEDITATION_COLORS, SCENE_COLORS, SCENES, STORY_COLORS, STORY_COVERS, TILE_COLORS, TILES } from '../../data/scenes';

// Art for the Sounds section: a square thumb and a wide banner per world, story, meditation and sound page.
const sources = [
  ...WORLDS.map((w) => [w.id, SCENES[w.id], SCENE_COLORS[w.id], 'center'] as const),
  ...STORIES.map((s) => [s.id, STORY_COVERS[s.id], STORY_COLORS[s.id], 'top'] as const),
  ...MEDITATIONS.map((m) => [m.id, MEDITATION_COVERS[m.id], MEDITATION_COLORS[m.id], 'center'] as const),
  ...SOUND_MIXES.map((m) => [m.id, TILES[m.layers[0][0]], TILE_COLORS[m.layers[0][0]], 'center'] as const),
].filter(([, src]) => src);
const ART = Object.fromEntries(await Promise.all(sources.map(async ([id, src, color, position]) => {
  const [thumb, wide] = await Promise.all([
    getImage({ src: src!, width: 112, height: 112, fit: 'cover', position, format: 'webp' }),
    getImage({ src: src!, width: 960, height: 400, fit: 'cover', position, format: 'webp' }),
  ]);
  const card = await getImage({ src: src!, width: 352, height: 200, fit: 'cover', position, format: 'webp' });
  return [id, { thumb: thumb.src, wide: wide.src, card: card.src, color: color ?? '#151a24' }];
})));

// The sidebar: Home on its own, then one group per part of the business. Settings sits with the account.
const GROUPS = [
  { label: '', items: [{ id: 'home', label: 'Home', icon: 'house' }] },
  { label: 'Website', items: [
    { id: 'overview', label: 'Overview', icon: 'chart-bar' },
    { id: 'live', label: 'Live', icon: 'monitor' },
    { id: 'visits', label: 'Visits', icon: 'trend-up' },
    { id: 'pages', label: 'Pages', icon: 'file-text' },
    { id: 'sources', label: 'Sources', icon: 'stack' },
    { id: 'audience', label: 'Audience', icon: 'users' },
    { id: 'clicks', label: 'Clicks & goals', icon: 'target' },
    { id: 'performance', label: 'Speed', icon: 'lightning' },
  ] },
  { label: 'Content', items: [{ id: 'sounds', label: 'Sounds', icon: 'music-notes' }] },
  { label: 'App', items: [{ id: 'appstore', label: 'TestFlight', icon: 'app-store-logo' }] },
];
const NAV = [...GROUPS.flatMap((g) => g.items), { id: 'settings', label: 'Settings', icon: 'gear-six' }];
// On phones: the five most used, and Search for everything else.
const TABS = ['home', 'overview', 'live', 'sounds', 'appstore'].map((id) => NAV.find((n) => n.id === id)!);

const logo = await getImage({ src: brandIcon, width: 80, height: 80, format: 'webp' });
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="#0b0e15">
<meta name="robots" content="noindex, nofollow">
<title>Sleep Moore Admin</title>
<meta name="description" content="Private visitor analytics for sleepmoore.app.">
<link rel="icon" type="image/png" href="/favicon.png">
<Font cssVariable="--font-sans" />
<Font cssVariable="--font-serif" preload={[{ weight: 400, style: 'normal' }, { weight: 600, style: 'normal' }]} />
</head>
<body class="is-booting">
<AdminSprite />

<div class="login" id="login" hidden>
  <div class="login-card">
    <div class="brand"><img class="brand-logo" src={logo.src} alt="" width="40" height="40"><span class="brand-name">Sleep Moore<span class="brand-sub">Admin</span></span></div>

    <form id="login-form" data-pane="login" novalidate>
      <h2>Sign in</h2>
      <p class="login-sub">Visitor analytics for sleepmoore.app.</p>
      <label class="field"><span>Email</span><input id="login-email" type="email" autocomplete="username" required></label>
      <div class="field">
        <div class="field-top"><label for="login-password">Password</label><button class="link-btn" type="button" data-show-pane="forgot">Forgot password?</button></div>
        <div class="pw"><input id="login-password" type="password" autocomplete="current-password" required><button class="pw-eye" type="button" data-reveal aria-label="Show password" aria-pressed="false"><svg class="i" aria-hidden="true"><use href="#a-eye" /></svg></button></div>
      </div>
      <p class="form-error" id="login-error" role="alert"></p>
      <button class="btn btn-primary btn-block" type="submit" id="login-submit">Sign in</button>
    </form>

    <form id="forgot-form" data-pane="forgot" novalidate hidden>
      <h2>Reset your password</h2>
      <p class="login-sub">Enter your email and we will send you a link to choose a new password.</p>
      <label class="field"><span>Email</span><input id="forgot-email" type="email" autocomplete="username" required></label>
      <p class="form-error" id="forgot-msg" role="alert"></p>
      <button class="btn btn-primary btn-block" type="submit" id="forgot-submit">Send reset link</button>
      <p class="login-alt"><button class="link-btn" type="button" data-show-pane="login"><svg class="i" aria-hidden="true"><use href="#a-caret-left" /></svg>Back to sign in</button></p>
    </form>

    <form id="reset-form" data-pane="reset" novalidate hidden>
      <h2>Choose a new password</h2>
      <p class="login-sub">Use at least 10 characters. You will be signed in straight after.</p>
      <input id="reset-username" type="email" autocomplete="username" hidden>
      <div class="field"><label for="reset-pw1">New password</label>
        <div class="pw"><input id="reset-pw1" type="password" autocomplete="new-password" minlength="10" required><button class="pw-eye" type="button" data-reveal aria-label="Show password" aria-pressed="false"><svg class="i" aria-hidden="true"><use href="#a-eye" /></svg></button></div></div>
      <div class="field"><label for="reset-pw2">Repeat it</label>
        <div class="pw"><input id="reset-pw2" type="password" autocomplete="new-password" minlength="10" required><button class="pw-eye" type="button" data-reveal aria-label="Show password" aria-pressed="false"><svg class="i" aria-hidden="true"><use href="#a-eye" /></svg></button></div></div>
      <p class="form-error" id="reset-msg" role="alert"></p>
      <button class="btn btn-primary btn-block" type="submit" id="reset-submit">Save and sign in</button>
    </form>
  </div>
</div>

<div class="shell" id="app" hidden>
  <aside class="side" aria-label="Sidebar">
    <div class="side-top">
      <a class="ws" href="#home" aria-label="Sleep Moore admin, home">
        <img class="ws-logo" src={logo.src} alt="" width="40" height="40">
        <span class="ws-name">Sleep Moore</span>
      </a>
      <button class="rail-btn" type="button" id="rail-toggle" aria-label="Collapse sidebar" aria-pressed="false" data-label="Collapse"><svg class="i" aria-hidden="true"><use href="#a-sidebar-simple" /></svg></button>
    </div>
    <button class="search-btn" type="button" data-palette data-label="Search"><svg class="i" aria-hidden="true"><use href="#a-magnifying-glass" /></svg><span>Search</span><kbd>Ctrl K</kbd></button>
    <nav class="nav" aria-label="Sections">
      {GROUPS.map((g) => (
        <div class="nav-group" data-group={g.label || 'top'}>
          {g.label && <button class="nav-label" type="button" aria-expanded="true" data-group-toggle={g.label}><span>{g.label}</span><svg class="i" aria-hidden="true"><use href="#a-caret-down" /></svg></button>}
          <div class="nav-items">
            {g.items.map((n) => (
              <a href={`#${n.id}`} data-nav={n.id} data-label={n.label}>
                <span class="nav-ico"><svg class="i off" aria-hidden="true"><use href={`#a-${n.icon}`} /></svg><svg class="i on" aria-hidden="true"><use href={`#a-${n.icon}-fill`} /></svg></span>
                <span class="nav-txt">{n.label}</span>
                {n.id === 'live' && <i class="nav-dot" data-live-dot></i>}
                {n.id === 'live' && <b class="nav-live" data-online hidden></b>}
              </a>
            ))}
          </div>
        </div>
      ))}
    </nav>
    <div class="side-foot">
      <a class="foot-row" href="#live" data-label="Live"><span class="foot-ico"><i class="dot-live" data-live-dot></i></span><span class="foot-txt">Live</span><b class="foot-num num" data-online hidden></b></a>
      <a class="foot-row" href="#settings" data-label="Owner" data-owner><span class="foot-ico"><svg class="i" aria-hidden="true"><use href="#a-user" /></svg></span><span class="foot-txt">Owner</span></a>
      <a class="foot-row" href="#settings" data-nav="settings" data-label="Settings"><span class="foot-ico"><svg class="i" aria-hidden="true"><use href="#a-gear-six" /></svg></span><span class="foot-txt">Settings</span></a>
    </div>
  </aside>

  <div class="main">
    <header class="bar">
      <div class="bar-row">
        <div class="title"><span class="crumb" id="crumb"></span><h1 id="title">Home</h1></div>
        <span class="online" data-online-pill hidden><i></i><span data-online-text></span></span>
        <div class="bar-tools" id="tools">
          <div class="range" id="range">
            <button class="btn btn-ghost range-btn" type="button" id="range-btn" aria-haspopup="true" aria-expanded="false">
              <svg class="i" aria-hidden="true"><use href="#a-calendar-blank" /></svg><span id="range-label">Last 7 days</span><svg class="i caret" aria-hidden="true"><use href="#a-caret-down" /></svg>
            </button>
            <div class="menu" id="range-menu" hidden></div>
          </div>
          <button class="btn cmp-btn" type="button" id="compare" aria-pressed="true" title="Compare with the period before">Compare</button>
          <button class="btn btn-icon" type="button" id="refresh" aria-label="Refresh"><svg class="i" aria-hidden="true"><use href="#a-arrows-clockwise" /></svg></button>
        </div>
      </div>
      <div class="chips" id="chips" hidden></div>
    </header>

    <main class="content" id="content">
      {NAV.map((n) => <section class="view" id={n.id} data-view={n.id} hidden aria-label={n.label}></section>)}
    </main>
  </div>
  <nav class="tabbar" aria-label="Sections, bottom bar">
    {TABS.map((n) => (
      <a href={`#${n.id}`} data-nav={n.id}><svg class="i" aria-hidden="true"><use href={`#a-${n.icon}`} /></svg><span>{n.id === 'appstore' ? 'App' : n.label}</span></a>
    ))}
    <button type="button" data-palette><svg class="i" aria-hidden="true"><use href="#a-magnifying-glass" /></svg><span>More</span></button>
  </nav>
</div>

<div class="palette" id="palette" hidden>
  <div class="palette-card" role="dialog" aria-modal="true" aria-label="Search">
    <div class="palette-top"><svg class="i" aria-hidden="true"><use href="#a-magnifying-glass" /></svg><input id="palette-q" type="text" placeholder="Go to a page, sound, country or date range" autocomplete="off" spellcheck="false"><kbd>Esc</kbd></div>
    <div class="palette-list" id="palette-list"></div>
  </div>
</div>
<div class="tip" id="tip" role="status" hidden></div>
<div class="toast" id="toast" role="status" hidden></div>

<script type="application/json" id="sound-art" set:html={JSON.stringify(ART)}></script>
<script>
  import '../../scripts/admin/main';
</script>
</body>
</html>
