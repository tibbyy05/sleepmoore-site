---
import GetApp from '../components/GetApp.astro';
import Icon from '../components/Icon.astro';
import SceneBuilder from '../components/SceneBuilder.astro';
import PlayIcons from '../components/PlayIcons.astro';
import PlayRing from '../components/PlayRing.astro';
import Scene from '../components/Scene.astro';
import GuidedCarousel from '../components/GuidedCarousel.astro';
import SoundCard from '../components/SoundCard.astro';
import { SOUND_PAGES, SOUND_PAGES_BY_SLUG } from '../data/library';
import { MEDITATION_COLORS, MEDITATION_COVERS, STORY_COLORS, STORY_COVERS } from '../data/scenes';
import { MEDITATIONS, STORIES } from '../data/worlds';
import Base from '../layouts/Base.astro';
import { DESTINATIONS, EMAIL, FAQ, MENU_HOME, NAV_HOME, PRESETS, SCENE_STRIP, SITE, stripTags } from '../data/site';

const site = SITE;
const org = { '@id': `${site}/#org` };
/** One graph for the home page: who makes the app, the site, the app itself and the questions. */
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      ...org,
      name: 'Sleep Moore',
      url: `${site}/`,
      logo: { '@type': 'ImageObject', url: `${site}/apple-touch-icon.png`, width: 180, height: 180 },
      email: EMAIL,
      contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', email: EMAIL, url: `${site}/support/` },
    },
    { '@type': 'WebSite', '@id': `${site}/#website`, name: 'Sleep Moore', url: `${site}/`, inLanguage: 'en', publisher: org },
    {
      '@type': 'MobileApplication',
      '@id': `${site}/#app`,
      name: 'Sleep Moore',
      operatingSystem: 'iOS, Android',
      applicationCategory: 'HealthApplication',
      applicationSubCategory: 'Sleep sounds',
      description: 'A free sleep sounds app. Ten sound worlds built from real recordings of rain, ocean, fire, wind and forest, three faders to mix them, a sleep timer that fades you out, sleep stories, guided sleep meditations and a gentle wake alarm. No account, no ads, no tracking.',
      featureList: [
        'Ten sleep sound worlds from real recordings',
        'Mix three sounds per world from a library of forty, including rain, ocean, white, pink and brown noise',
        'Sleep timer that fades the sound out gradually',
        'Keeps playing with the screen locked',
        `${STORIES.length} sleep stories read aloud`,
        `${MEDITATIONS.length} guided sleep meditations, including Yoga Nidra`,
        'Gentle wake alarm',
        'No account, no ads, no tracking',
      ],
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      isAccessibleForFree: true,
      inLanguage: 'en',
      url: `${site}/`,
      image: `${site}/img/og-cabin.jpg`,
      publisher: org,
    },
    {
      '@type': 'FAQPage',
      '@id': `${site}/#faq`,
      mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: stripTags(f.a) } })),
    },
  ],
};

/** The sounds people search for most, on the home page; the rest are on /sounds/. */
const HOME_SOUNDS = ['rain', 'brown-noise', 'ocean-waves', 'thunderstorm', 'white-noise', 'fan', 'fireplace', 'pink-noise'];

const storyItems = STORIES.map((s) => ({ href: `/stories/${s.id}/`, id: s.id, name: s.name, line: s.tagline, meta: `Night journey · ${s.minutes} min`, icon: s.icon, cover: STORY_COVERS[s.id], color: STORY_COLORS[s.id], badge: s.isNew ? 'New' : undefined }));
const meditationItems = MEDITATIONS.map((m) => ({ href: `/meditations/${m.id}/`, id: m.id, name: m.name, line: m.tagline, meta: `${m.minutes} min · ${m.kind}`, icon: m.icon, cover: MEDITATION_COVERS[m.id], color: MEDITATION_COLORS[m.id] }));
const storyRange = `${Math.min(...STORIES.map((s) => s.minutes))} to ${Math.max(...STORIES.map((s) => s.minutes))}`;

/** The night story: what the stage shows at each step (scene behind, app screen on the phone). */
const SCENES = ['rainy-cabin', 'moonlit-cove', 'snowfall-lodge', 'desert-camp', 'dawn'];
const SCREENS = ['home', 'explore', 'routine', null, 'welcome'];
---
<Base
  home
  title="Free sleep sounds app: rain, ocean and nature | Sleep Moore"
  description="Sleep Moore is a free sleep sounds app: rain, ocean, forest and fire sound worlds from real recordings, a sleep timer that fades out, sleep stories and meditations. No account, no ads."
  socialTitle="Sleep Moore: somewhere quieter."
  socialDescription="Sound worlds for deeper rest, any night of the week. Free, with no account, no ads and no tracking."
  nav={NAV_HOME}
  menu={MENU_HOME}>
  <Fragment slot="preload">
    <link rel="preload" as="image" href="/img/hero-cabin-1440.webp" imagesrcset="/img/hero-cabin-960.webp 960w, /img/hero-cabin-1440.webp 1440w, /img/hero-cabin-1920.webp 1920w, /img/hero-cabin-2560.webp 2560w" imagesizes="100vw" media="(min-width: 761px)" fetchpriority="high">
    <link rel="preload" as="image" href="/img/hero-cabin-stove-mobile.webp" imagesrcset="/img/hero-cabin-stove-mobile.webp 450w, /img/hero-cabin-stove-mobile-2x.webp 800w" imagesizes="100vw" media="(max-width: 760px)" fetchpriority="high">
  </Fragment>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
  </Fragment>

  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-art" aria-hidden="true">
      <picture>
        <source media="(max-width: 760px)" srcset="/img/hero-cabin-stove-mobile.webp 450w, /img/hero-cabin-stove-mobile-2x.webp 800w" sizes="100vw" width="800" height="1434">
        <source srcset="/img/hero-cabin-960.webp 960w, /img/hero-cabin-1440.webp 1440w, /img/hero-cabin-1920.webp 1920w, /img/hero-cabin-2560.webp 2560w" sizes="100vw" type="image/webp">
        <img src="/img/hero-cabin.jpg" alt="" width="1920" height="1074" fetchpriority="high" decoding="async">
      </picture>
      <canvas class="ambience" data-ambience="hero"></canvas>
    </div>
    <div class="hero-copy">
      <p class="cap hero-eyebrow">Free sleep sounds app</p>
      <h1 id="hero-title">Somewhere <br>quieter.</h1><script is:inline>splitLetters(document.currentScript.previousElementSibling)</script>
      <p class="lede">Sound worlds for deeper rest, <br>any night of the week.</p>
      <button class="play-pill" type="button" data-play-world="rainy-cabin" aria-pressed="false" data-dock-hide>
        <PlayIcons />
        <span data-label>Play this soundscape</span>
      </button>
      <p class="hero-note">The real app sound. Move a fader and the room follows. <a class="nudge" href="#get">All night, screen off, in the app <span aria-hidden="true">&rarr;</span></a></p>
    </div>

    <p class="ios-hint" data-ios-hint>Hearing nothing on iPhone? Flip the side switch off silent and turn the volume up.</p>
    <div class="moods" data-moods role="group" aria-label="Moods for the cabin"></div>
    <div class="player" id="player" role="region" aria-label="Now playing" data-dock-hide>
      <button class="player-toggle" type="button" aria-label="Play" data-toggle>
        <PlayIcons />
      </button>
      <span class="player-name" data-now>Rainy Cabin</span>
      <span class="meter" aria-hidden="true" data-meter><i></i><i></i><i></i><i></i><i></i></span>
      <div class="hero-mix" data-hero-mix="rainy-cabin" role="group" aria-label="Mix the cabin: each fader changes the sound and the picture"></div>
      <span class="player-time" data-time>45:00</span>
      <button class="player-mute" type="button" aria-label="Mute" aria-pressed="false" data-mute>
        <Icon name="speaker" class="ic-vol" /><Icon name="muted" class="ic-muted" />
      </button>
    </div>
  </section>

  <!-- Proof strip -->
  <section class="proof" aria-label="What you should know">
    <div class="wrap">
      <ul class="proof-list" role="list">
        <li><Icon name="sparkle" /><span><b>Free, for good</b><small>Everything at launch stays free</small></span></li>
        <li><Icon name="no-account" /><span><b>No account</b><small>Nothing to sign up for, ever</small></span></li>
        <li><Icon name="waveform" /><span><b>Plays in your browser</b><small>Real loops, mixed live on this page</small></span></li>
        <li><Icon name="phone" /><span><b>iPhone and Android</b><small>Coming soon to both stores</small></span></li>
      </ul>
    </div>
  </section>

  <!-- Find your quiet -->
  <section class="find" id="worlds" aria-labelledby="find-title">
    <div class="wrap">
      <header class="sec-head reveal">
        <h2 id="find-title">Find your quiet.</h2>
        <p class="sub">Ten destinations for rest and renewal. Step inside one, and the sound comes with you.</p>
      </header>
      <div class="find-grid">
        <a class="feature-card reveal" href="/worlds/alpine-lake/" data-play-world="alpine-lake">
          <Scene id="alpine-lake" described widths={[900, 1400, 1800]} sizes="(max-width: 1024px) 100vw, 58vw" />
          <span class="feature-text">
            <span class="cap">Feature destination</span>
            <span class="feature-name">Alpine Lake</span>
          </span>
          <span class="go-ring" aria-hidden="true"><Icon name="arrow-right" /></span>
        </a>

        <ul class="dest-list reveal" role="list">
          {DESTINATIONS.map((d) => (
            <li>
              <a class="dest" href={`/worlds/${d.id}/`} data-play-world={d.id}>
                <Scene id={d.id} widths={[240, 360]} sizes="120px" />
                <span class="dest-text"><span class="cap">{d.cap}</span><span class="dest-name">{d.name}</span><span class="dest-line">{d.line}</span></span>
                <span class="go-ring sm" aria-hidden="true"><Icon name="arrow-right" /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <ul class="scene-strip reveal" role="list" aria-label="More worlds">
        {SCENE_STRIP.map((s) =>
          s.play ? (
            <li><a href={`/worlds/${s.id}/`} data-play-world={s.id}><Scene id={s.id} widths={[360, 560]} sizes="(max-width: 760px) 50vw, (max-width: 1024px) 33vw, 200px" /><span>{s.name}</span></a></li>
          ) : (
            <li><figure><Scene id={s.id} described widths={[360, 560]} sizes="(max-width: 760px) 50vw, (max-width: 1024px) 33vw, 200px" /><figcaption>{s.name} <small>In the app</small></figcaption></figure></li>
          ),
        )}
      </ul>
    </div>
  </section>

  <!-- Every sound on its own -->
  <section class="sounds-home" id="sounds" aria-labelledby="sounds-title">
    <div class="wrap">
      <header class="sec-head reveal">
        <h2 id="sounds-title">Every sound, on its own.</h2>
        <p class="sub">Rain, a fire, a night train, brown noise. Tap one to hear it, then blend in another.</p>
      </header>
      <ul class="sound-grid reveal" role="list">
        {HOME_SOUNDS.map((slug) => <li><SoundCard page={SOUND_PAGES_BY_SLUG[slug]} /></li>)}
      </ul>
      <p class="sounds-more"><a href="/sounds/">All {SOUND_PAGES.length} sleep sounds</a><span aria-hidden="true">·</span><a href="/guides/brown-pink-white-green-noise/">Brown, pink or white noise?</a></p>
    </div>
  </section>

  <GuidedCarousel
    sectionId="stories"
    eyebrow="Night journeys"
    title="Stories to fall asleep to."
    sub="Read slowly by one calm voice, with the sounds of the place underneath. Press play to hear how each one begins."
    note={`In the app each journey runs ${storyRange} minutes: the story, then the sounds carry on and fade as you sleep.`}
    nudge="Hear the whole story in the app"
    play="Hear the opening"
    label="Night journeys"
    items={storyItems}
  />

  <GuidedCarousel
    sectionId="meditations"
    eyebrow="Guided meditations"
    title="Quiet the mind, soften the body."
    sub="Short sessions for the moments sleep won't come, read by the same calm voice over a soft pad. Press play for the first minutes."
    note="In the app the pad plays on after the voice ends, then fades, and the screen dims for the night."
    nudge="Full sessions in the app"
    play="Try the first minutes"
    label="Guided meditations"
    items={meditationItems}
    alt
  />

  <!-- One night with the app -->
  <section class="night" id="night" aria-labelledby="night-title">
    <div class="wrap">
      <header class="sec-head reveal">
        <h2 id="night-title">One night with Sleep Moore.</h2>
        <p class="sub">The real app, from wind-down to waking.</p>
      </header>
      <div class="night-grid">
        <div class="night-stage" aria-hidden="true">
          <div class="stage-card">
            <div class="stage-scenes">
              {SCENES.map((s, i) => (
                <Scene id={s} class={i === 0 ? 'is-on' : undefined} data-scene={i} widths={[900, 1344]} sizes="(max-width: 1024px) 100vw, 50vw" />
              ))}
              <div class="stage-dim" data-dim></div>
            </div>
            <div class="phone">
              <div class="phone-screen">
                {SCREENS.map((s, i) =>
                  s ? (
                    <img class={i === 0 ? 'is-on' : undefined} data-screen={i} src={`/img/app/${s}-390.webp`} srcset={`/img/app/${s}-390.webp 390w, /img/app/${s}-780.webp 780w`} sizes="(max-width: 760px) 40vw, 20vw" alt="" width="390" height="844" loading="lazy">
                  ) : (
                    <div class="screen-off" data-screen={i}><span>11:35</span></div>
                  ),
                )}
              </div>
            </div>
          </div>
        </div>

        <ol class="night-steps" data-steps>
          <li class="step is-on" data-step="0">
            <p class="cap step-time">10:40 pm</p>
            <h3>Wind down</h3>
            <p>Open the app and it is already quiet. One warm picture, one button, no feed to scroll. The phone stops asking for attention before you have put it down.</p>
          </li>
          <li class="step" data-step="1">
            <p class="cap step-time">10:48 pm</p>
            <h3>Choose a world, make it yours</h3>
            <p>Swipe through ten places built from real recordings. Each one is three sounds on a small mixing desk: rain up, fire down, wind barely there.</p>
          </li>
          <li class="step" data-step="2">
            <p class="cap step-time">10:50 pm</p>
            <h3>Set the timer, breathe</h3>
            <p>Forty-five minutes, an hour, or until you are up. A few minutes of guided breathing settles a busy head before the sound takes over.</p>
          </li>
          <li class="step" data-step="3">
            <p class="cap step-time">11:35 pm</p>
            <h3>Drift off</h3>
            <p>The screen is dark. The loops have no seam to catch on, and the fade has already begun. Lock-screen controls are there if you want them.</p>
          </li>
          <li class="step" data-step="4">
            <p class="cap step-time">6:50 am</p>
            <h3>Wake gently</h3>
            <p>Dawn rises softly over ten, twenty or thirty minutes to the time you need to be up. No jolt, no blaring alarm. Tonight it asks how you slept.</p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- Make it yours -->
  <section class="make" id="mix" aria-labelledby="make-title">
    <div class="wrap">
      <header class="sec-head reveal">
        <h2 id="make-title">Build your scene.</h2>
        <p class="sub sans">Drag a sound into the night: a campfire, a rain cloud, a stream, crickets, the wind. Each one plays as it lands. Tap it to send it away.</p>
      </header>
      <SceneBuilder />
      <p class="presets-note">In the app, swap any layer for one of forty recorded sounds and save the mix. It is waiting tomorrow night. <a class="nudge" href="#get">Save your scene in the app <span aria-hidden="true">&rarr;</span></a></p>
    </div>
  </section>

  <!-- Free -->
  <section class="free" id="free" aria-labelledby="free-title">
    <div class="wrap">
      <div class="free-grid">
        <div class="free-copy reveal">
          <h2 id="free-title">Free. No account, <br>no ads, no tracking.</h2>
          <p class="free-lede">Most sleep apps are loud about being calm: a feed of courses, a streak to keep, a paywall before the first sound plays. Sleep Moore is one idea, done quietly.</p>
        </div>
        <dl class="facts reveal">
          <div><dt>Free, for good</dt><dd>Everything in the app at launch stays free. A later Sleep Moore+ will add new content only.</dd></div>
          <div><dt>Nothing to sign up for</dt><dd>Open it and press play. Your saved mixes live on your phone, not on our servers.</dd></div>
          <div><dt>Quiet by design</dt><dd>No streaks, no feed, no notifications you did not ask for. <a href="/privacy/">Read the privacy policy</a>.</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Questions -->
  <section class="faq" id="faq" aria-labelledby="faq-title">
    <div class="wrap">
      <header class="sec-head reveal">
        <h2 id="faq-title">Questions, answered.</h2>
      </header>
      <div class="faq-list reveal">
        {FAQ.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p set:html={f.a} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <GetApp />
</Base>
