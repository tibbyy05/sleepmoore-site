---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Dock from '../components/Dock.astro';
import IconSprite from '../components/IconSprite.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { type Link, MENU_PAGE, NAV_PAGE, SITE } from '../data/site';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  /** Home page: in-page header links and the safe-area viewport. */
  home?: boolean;
  /** Full-bleed pages (home, worlds) want the safe-area viewport too. */
  fullBleed?: boolean;
  nav?: Link[];
  menu?: Link[];
  /** Social preview image, absolute URL, 1200 x 630 unless imageSize says otherwise. Defaults to the cabin. */
  image?: string;
  imageSize?: [number, number];
  /** What the preview image shows. */
  imageAlt?: string;
  /** Shorter title and description for link previews, when the search ones are too long. */
  socialTitle?: string;
  socialDescription?: string;
}
const {
  title, description, home = false, fullBleed = home, nav = NAV_PAGE, menu = MENU_PAGE,
  image = `${SITE}/img/og-cabin.jpg`, imageSize = [1200, 630], imageAlt = 'A bed facing a wide window onto moonlit mountains, a fire and a lamp glowing',
  socialTitle = title, socialDescription = description,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content={fullBleed ? 'width=device-width, initial-scale=1, viewport-fit=cover' : 'width=device-width, initial-scale=1'}>
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="#0b0e15">
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Sleep Moore">
<meta property="og:locale" content="en_US">
<meta property="og:title" content={socialTitle}>
<meta property="og:description" content={socialDescription}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={image}>
<meta property="og:image:width" content={String(imageSize[0])}>
<meta property="og:image:height" content={String(imageSize[1])}>
<meta property="og:image:alt" content={imageAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={socialTitle}>
<meta name="twitter:description" content={socialDescription}>
<meta name="twitter:image" content={image}>
<meta name="twitter:image:alt" content={imageAlt}>
<slot name="meta" />
<link rel="canonical" href={canonical}>
<link rel="icon" type="image/png" href="/favicon.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="alternate" type="text/plain" href="/llms.txt" title="Sleep Moore for AI assistants">
<Font cssVariable="--font-sans" preload={[{ weight: 400, style: 'normal' }, { weight: 800, style: 'normal' }]} />
<slot name="preload" />
{/* Splits a heading into letters for the ink-rise entrance, before first paint, keeping a screen-reader copy. Defined on every page so client-side page changes always have it. */}
<script is:inline>
function splitLetters(el){if(!el||el.querySelector('.ch'))return;var full=el.textContent.replace(/\s+/g,' ').trim(),i=0;Array.prototype.slice.call(el.childNodes).forEach(function(n){if(n.nodeType!==3)return;var f=document.createDocumentFragment();n.textContent.split(/(\s+)/).forEach(function(part){if(!part)return;if(/^\s+$/.test(part)){f.appendChild(document.createTextNode(' '));i++;return}var w=document.createElement('span');w.className='w';part.split('').forEach(function(c){var s=document.createElement('span');s.className='ch';s.setAttribute('aria-hidden','true');s.style.setProperty('--i',i);s.style.setProperty('--d',(2.4+(i%4)*0.4)+'s');var b=document.createElement('span');b.className='b';b.textContent=c;s.appendChild(b);w.appendChild(s);i++});f.appendChild(w)});el.replaceChild(f,n)});Array.prototype.slice.call(el.querySelectorAll('br')).forEach(function(b){b.setAttribute('aria-hidden','true')});var sr=document.createElement('span');sr.className='sr-only';sr.textContent=full;el.insertBefore(sr,el.firstChild)}
</script>
<ClientRouter />
<slot name="head" />
</head>
<body>
<IconSprite />
<a class="skip" href="#main">Skip to content</a>
<SiteHeader nav={nav} menu={menu} getHref={home ? '#get' : '/#get'} animateBrand={home} />
<main id="main">
<slot />
</main>
<SiteFooter />
<Dock />
<script>
  import '../scripts/app';
  // Visitor analytics load once the page is idle, so they never compete with the first paint.
  const loadPulse = () => import('../scripts/pulse');
  const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(loadPulse, { timeout: 3000 }) : setTimeout(loadPulse, 1500));
  if (document.readyState === 'complete') idle(); else addEventListener('load', idle, { once: true });
</script>
</body>
</html>
