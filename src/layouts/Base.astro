---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { type Link, NAV_PAGE } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Home page: in-page header links, split-letter brand, GSAP motion, safe-area viewport. */
  home?: boolean;
  nav?: Link[];
  menu?: Link[];
}
const { title, description, home = false, nav = NAV_PAGE, menu = NAV_PAGE } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fonts = 'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:wght@400;500;600&display=swap';
---
<!doctype html>
<html lang="en" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content={home ? 'width=device-width, initial-scale=1, viewport-fit=cover' : 'width=device-width, initial-scale=1'}>
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="#0b0e15">
<title>{title}</title>
<meta name="description" content={description}>
<slot name="meta" />
<link rel="canonical" href={canonical}>
<link rel="icon" type="image/png" href="/favicon.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
{home && <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>}
<link rel="preload" as="style" href={fonts}>
<link rel="stylesheet" href={fonts} media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href={fonts}></noscript>
<slot name="preload" />
<link rel="stylesheet" href="/site.css">
<slot name="head" />
</head>
<body>
{home && <a class="skip" href="#main">Skip to content</a>}
<SiteHeader nav={nav} menu={menu} getHref={home ? '#get' : '/#get'} animateBrand={home} />
<main id={home ? 'main' : undefined}>
<slot />
</main>
<SiteFooter />
{home && <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/gsap.min.js" defer crossorigin="anonymous" referrerpolicy="no-referrer"></script>}
{home && <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/ScrollTrigger.min.js" defer crossorigin="anonymous" referrerpolicy="no-referrer"></script>}
<script is:inline src="/site.js" defer></script>
</body>
</html>
